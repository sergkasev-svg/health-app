      "сладкое после жирного"
    ]
  },
  "red_flags": [
    "сильная или нарастающая боль в верхней части живота",
    "сильная боль справа под рёбрами",
    "боль, отдающая в спину",
    "многократная рвота",
    "температура или озноб",
    "чёрный стул",
    "кровь в рвоте",
    "кровь в стуле",
    "обморок",
    "выраженное головокружение",
    "одышка",
    "боль в груди",
    "желтуха",
    "невозможность пить жидкость",
    "редкое мочеиспускание / признаки обезвоживания",
    "резкое ухудшение общего состояния"
  ],
  "actions_patient_safe": {
    "default_now": [
      "пить воду маленькими порциями",
      "не ложиться сразу после еды",
      "временно избегать жирной, тяжёлой и раздражающей пищи",
      "наблюдать за динамикой в ближайшие часы",
      "фиксировать, какой продукт стал триггером, если это повторяется"
    ],
    "if_reflux_like": [
      "не ложиться",
      "не есть поздно",
      "избегать переедания"
    ],
    "if_bloating_diarrhea_like": [
      "следить за жидкостью",
      "временно упростить питание",
      "оценить связь с молочным, сладким, FODMAP-продуктами"
    ],
    "if_systemic_weakness_like": [
      "сесть или прилечь с приподнятой головой",
      "оценить, не было ли сладкого, алкоголя, большой тяжёлой еды и нехватки жидкости"
    ]
  },
  "tests_logic": {
    "single_mild_episode": {
      "recommend_immediate_tests": false,
      "message": "При единичном лёгком эпизоде без красных флагов срочные анализы обычно не нужны."
    },
    "recurrent_upper_gi_or_fatty_food_pattern": {
      "recommend_tests": [
        "АЛТ",
        "АСТ",
        "билирубин",
        "ГГТ",
        "амилаза",
        "липаза",
        "УЗИ органов брюшной полости"
      ]
    },
    "recurrent_dairy_pattern": {
      "recommend_tests": [
        "оценка непереносимости молочного по симптомам и пищевому дневнику"
      ]
    },
    "recurrent_dyspepsia_or_ulcer_risk_pattern": {
      "recommend_tests": [
        "обсуждение H. pylori",
