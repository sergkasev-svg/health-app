      ]
    },
    "histamine_pattern": {
      "recommend_tests": [
        "обсуждать только при типичном повторяемом паттерне"
      ],
      "avoid": [
        "не рекомендовать всем подряд DAO",
        "не рекомендовать всем подряд гистамин в крови",
        "не рекомендовать IgG-панели совместимости"
      ]
    },
    "urgent_pattern": {
      "recommend_urgent_evaluation": true
    }
  },
  "output_template": {
    "patient_safe_sections": [
      "что вероятнее всего",
      "какие ещё причины возможны",
      "что делать сейчас",
      "когда срочно обращаться",
      "нужны ли анализы, если это повторяется"
    ]
  }
}
