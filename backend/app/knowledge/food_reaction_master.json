{
  "module": "food_reaction_master",
  "version": "2.0",
  "intent": "patient_safe_food_symptom_reasoning",
  "description": "Unified engine for food-related nausea, headache, heaviness, bloating, reflux-like symptoms, upper abdominal discomfort, and food-triggered GI reactions.",
  "core_reasoning_policy": {
    "default_priority_order": [
      "fatty_fried_overload",
      "functional_dyspepsia_or_gastric_irritation",
      "biliary_reaction",
      "pancreatic_overload",
      "reflux_trigger",
      "dairy_lactose_or_milk_sensitivity",
      "postprandial_vascular_reaction",
      "simple_overeating",
      "ibs_food_trigger",
      "histamine_trigger_conditional",
      "sugar_load_reaction",
      "alcohol_related_reaction"
    ],
    "rules": [
      "Do not make histamine the default explanation.",
      "For fried/fatty meals, first consider GI overload, dyspepsia, biliary reaction, reflux, overeating.",
      "For dairy, first separate lactose-type pattern from fat-trigger pattern.",
      "For wine, cheese, smoked or fermented foods, only elevate histamine if pattern repeats and includes flushing, palpitations, itching, nasal symptoms, migraine-like headache.",
      "For IBS, require bowel-pattern clues such as bloating plus diarrhea/constipation or pain linked to bowel movement.",
      "If red flags are present, stop household advice and escalate to urgent evaluation."
    ]
  },
